# OLLAMA_URL: NO setearla en Dokploy. El compose resuelve solo el service interno
# http://ollama:11434 (Ollama encapsulado en el mismo proyecto) y, como default,
# usa ese valor. Setearla a "http://localhost:11434" hace que el gateway se llame
# a si mismo (localhost = el propio contenedor) y devuelva 502.
# Descomentada solo sirve para dev local, con el Ollama del host en 127.0.0.1:11434.
# OLLAMA_URL=http://localhost:11434
GATEWAY_API_KEYS=change-me-chat,change-me-resumenes
ALLOWED_MODELS=lfm2.5:8b
MAX_CONCURRENT=2
QUEUE_TIMEOUT=30
UPSTREAM_TIMEOUT=300
# Razonamiento por defecto cuando el cliente no lo manda (none|low|medium|high|"" para no inyectar)
DEFAULT_REASONING_EFFORT=none
