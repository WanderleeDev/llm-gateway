# Local dev: Ollama del host. En Dokploy NO se setea: el compose apunta al
# service interno http://ollama:11434 (Ollama encapsulado en el mismo proyecto).
OLLAMA_URL=http://localhost:11434
GATEWAY_API_KEYS=change-me-chat,change-me-resumenes
ALLOWED_MODELS=lfm25-8b
MAX_CONCURRENT=2
QUEUE_TIMEOUT=30
UPSTREAM_TIMEOUT=300
# Razonamiento por defecto cuando el cliente no lo manda (none|low|medium|high|"" para no inyectar)
DEFAULT_REASONING_EFFORT=none
