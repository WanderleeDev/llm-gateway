# OLLAMA_URL: do NOT set this in Docker Compose. The compose file already defaults
# to the internal service DNS name (http://ollama:11434), because Ollama runs as a
# sibling service in the same project. Setting it to "http://localhost:11434" makes
# the gateway call itself (inside a container, localhost is the container) and return 502.
# Uncomment only for local development against a host Ollama on 127.0.0.1:11434.
# OLLAMA_URL=http://localhost:11434
GATEWAY_API_KEYS=change-me-chat,change-me-summaries
ALLOWED_MODELS=lfm2.5:8b
MAX_CONCURRENT=2
QUEUE_TIMEOUT=30
UPSTREAM_TIMEOUT=300
# Reasoning effort injected when the client omits it (none|minimal|low|medium|high|"" to inject nothing)
DEFAULT_REASONING_EFFORT=none
