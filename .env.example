# OLLAMA_URL: do NOT set this in Docker Compose. The compose file already defaults
# to the internal service DNS name (http://ollama:11434), because Ollama runs as a
# sibling service in the same project. Setting it to "http://localhost:11434" makes
# the gateway call itself (inside a container, localhost is the container) and return 502.
# Uncomment only for local development against a host Ollama on 127.0.0.1:11434.
# OLLAMA_URL=http://localhost:11434
GATEWAY_API_KEYS=change-me-chat,change-me-summaries
ALLOWED_MODELS=qwen3.5:4b
# Chat model pulled by the `ollama-init` one-shot. Keep it identical to the first
# entry of ALLOWED_MODELS, or the gateway will accept a model Ollama never pulled.
OLLAMA_CHAT_MODEL=qwen3.5:4b
# Embedding models accepted by /v1/embeddings. Empty means the endpoint rejects
# every model. Keep it separate from ALLOWED_MODELS on purpose: a chat model
# cannot serve embeddings, and each endpoint enforces its own allowlist.
ALLOWED_EMBEDDING_MODELS=qwen3-embedding:0.6b
MAX_CONCURRENT=2
QUEUE_TIMEOUT=30
UPSTREAM_TIMEOUT=300
# Reasoning effort injected when the client omits it (none|minimal|low|medium|high|"" to inject nothing)
# "medium" keeps thinking on, like OpenAI; send think:false to get the fast path.
DEFAULT_REASONING_EFFORT=medium
